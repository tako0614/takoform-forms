              "integer",
              "null"
            ]
          }
        },
        "required": [
          "atMillis"
        ],
        "type": "object"
      },
      "errors": [
        "backend_unavailable"
      ],
      "idempotent": true
    },
    {
      "name": "alarmClear",
      "description": "Remove the pending alarm. It succeeds when none was pending: the outcome asked for is the outcome that holds, so a retry after a lost response is not an error.",
      "inputSchema": {
