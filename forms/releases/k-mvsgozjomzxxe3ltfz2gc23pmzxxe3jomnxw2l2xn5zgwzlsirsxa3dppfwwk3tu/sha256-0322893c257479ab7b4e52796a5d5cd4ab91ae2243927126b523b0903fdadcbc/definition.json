{
  "apiVersion": "edge.forms.takoform.com",
  "kind": "WorkerDeployment",
  "definitionVersion": "0.3.0",
  "title": "Worker Deployment",
  "description": "Unpublished aggregate WorkerDeployment selecting the one Actor+Workflow WorkerVersion candidate. Its exact worker and version relations pin the forward ModuleWorker and shared WorkerVersion Definitions; current deployment bytes remain unchanged.",
  "role": "deployment",
  "requiresHostApi": "forms.takoform.com/v1",
  "constraints": [
    {
      "kind": "exclusive",
      "reference": "/worker"
    },
    {
      "kind": "sum",
      "list": "/versions",
      "member": "weight",
      "total": 10000
    }
  ],
  "desiredSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Unpublished aggregate WorkerDeployment selecting the one Actor+Workflow WorkerVersion candidate. Its exact worker and version relations pin the forward ModuleWorker and shared WorkerVersion Definitions; current deployment bytes remain unchanged.",
    "properties": {
      "versions": {
        "description": "Active Worker Versions and their traffic weights in basis points. Weights must sum to exactly 10000.",
        "items": {
          "additionalProperties": false,
          "properties": {
            "weight": {
              "description": "Traffic share in basis points (1..10000).",
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            "workerVersion": {
              "additionalProperties": false,
              "description": "Worker Version receiving this weight.",
              "properties": {
                "apiVersion": {
                  "const": "edge.forms.takoform.com",
                  "type": "string"
                },
                "kind": {
                  "const": "WorkerVersion",
                  "type": "string"
                },
                "name": {
                  "maxLength": 63,
                  "minLength": 1,
                  "pattern": "^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$",
                  "type": "string"
                }
              },
              "required": [
                "apiVersion",
                "kind",
                "name"
              ],
              "type": "object",
              "x-takoform-target-formrefs": [
                {
                  "apiVersion": "edge.forms.takoform.com",
                  "definitionVersion": "0.4.0",
                  "kind": "WorkerVersion",
                  "schemaDigest": "sha256:aa013abbf36367707e8f176e284d2cd19e59effd1f8af560c8a8a36b0c53ec21"
                }
              ]
            }
          },
          "required": [
            "weight",
            "workerVersion"
          ],
          "type": "object"
        },
        "maxItems": 8,
        "minItems": 1,
        "type": "array",
        "uniqueItems": true
      },
      "worker": {
        "additionalProperties": false,
        "description": "Module Worker identity whose traffic this deployment governs.",
        "properties": {
          "apiVersion": {
            "const": "edge.forms.takoform.com",
            "type": "string"
          },
          "kind": {
            "const": "ModuleWorker",
            "type": "string"
          },
          "name": {
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$",
            "type": "string"
          }
        },
        "required": [
          "apiVersion",
          "kind",
          "name"
        ],
        "type": "object",
        "x-takoform-target-formrefs": [
          {
            "apiVersion": "edge.forms.takoform.com",
            "definitionVersion": "0.2.0",
            "kind": "ModuleWorker",
            "schemaDigest": "sha256:761180705a6f2a75fa0bc0061794a269342fafe0309c26ecd7530f12fcda1399"
          }
        ]
      }
    },
    "required": [
      "versions",
      "worker"
    ],
    "title": "Worker Deployment desired state",
    "type": "object"
  },
  "immutableFields": [
    "/worker"
  ],
  "lifecycleCapabilities": [
    "create",
    "read",
    "update",
    "delete",
    "import",
    "observe"
  ],
  "conformanceFixtures": [
    {
      "name": "canonical",
      "desiredPath": "fixtures/desired.json"
    }
  ],
  "negativeConformanceFixtures": [
    {
      "name": "reject-unexpected-property",
      "stage": "desired",
      "inputPath": "fixtures/negative-unexpected-property.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-missing-worker",
      "stage": "desired",
      "inputPath": "fixtures/negative-missing-worker.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-missing-versions",
      "stage": "desired",
      "inputPath": "fixtures/negative-missing-versions.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-worker",
      "stage": "desired",
      "inputPath": "fixtures/negative-worker.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-versions",
      "stage": "desired",
      "inputPath": "fixtures/negative-versions.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-versions-worker-version",
      "stage": "desired",
      "inputPath": "fixtures/negative-versions-worker-version.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-versions-weight",
      "stage": "desired",
      "inputPath": "fixtures/negative-versions-weight.json",
      "expectedFailure": "schema_validation_failed"
    }
  ]
}
