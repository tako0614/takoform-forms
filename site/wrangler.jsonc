{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "takoform-edge-form-pages",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
